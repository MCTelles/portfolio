NODE_ENV=development
PORT=3333

# Postgres do docker-compose (porta 5433 no host)
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
JWT_EXPIRES_IN_HOURS=8

# Origem do frontend (CORS com credenciais)
WEB_ORIGIN=http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Proxies confiáveis na frente da API (produção: Vercel + Render = 2)
TRUST_PROXY_HOPS=1

# Imagens: "local" (disco, dev) ou "s3" (bucket S3/Cloudflare R2, produção)
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=portfolio
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Usados apenas pelo seed (npm run db:seed) para criar/atualizar o admin
ADMIN_NAME=Marcelo
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha-forte
# Perfil, skills e projetos de exemplo no seed (use false em produção)
SEED_DEMO_CONTENT=true
